{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard"
    ],
    "enabledManagers": [
        "terragrunt",
        "terraform"
    ],
    "terragrunt": {
        "managerFilePatterns": [
            "/\\.hcl$/"
        ],
        "versioning": "regex:^((?<compatibility>.*)-v|v*)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    "packageRules": [
        {
            "matchDatasources": [
                "git-tags",
                "github-tags",
                "terraform-module"
            ],
            "groupName": "infrastructure modules",
            "matchPackageNames": [
                "/terraform-patterns-modules/"
            ]
        },
        {
            "matchFileNames": [
                "**/development-account/**"
            ],
            "automerge": true
        },
        {
            "matchFileNames": [
                "**/production-account/**"
            ],
            "minimumReleaseAge": "7 days"
        }
    ]
}
